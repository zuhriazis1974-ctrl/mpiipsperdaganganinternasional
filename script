/* RESET & LAYOUT DASAR KHUSUS LAYAR BESAR / IFP */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    user-select: none; /* Mencegah seleksi teks saat disentuh banyak jari */
}

body {
    background: #0f172a;
    color: #f8fafc;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
}

.ifp-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, #1e293b, #0f172a);
}

/* HEADER */
.ifp-header {
    background: #1e293b;
    border-bottom: 4px solid #3b82f6;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header-title {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #60a5fa;
    font-size: 1.5rem;
}

.header-subtitle {
    font-size: 1.2rem;
    color: #94a3b8;
    font-weight: 600;
}

/* MAIN CONTENT VIEWS */
.ifp-main {
    flex: 1;
    position: relative;
    padding: 40px;
    overflow-y: auto;
}

.view {
    display: none;
    height: 100%;
    animation: fadeIn 0.3s ease-in-out;
}

.view.active {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* MENU UTAMA */
.welcome-banner {
    text-align: center;
    margin-bottom: 40px;
}

.welcome-banner h2 {
    font-size: 2.5rem;
    color: #f8fafc;
    margin-bottom: 10px;
}

.welcome-banner p {
    font-size: 1.3rem;
    color: #94a3b8;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    width: 80%;
    max-width: 900px;
}

.menu-btn {
    background: #334155;
    border: 3px solid #475569;
    border-radius: 20px;
    padding: 40px;
    color: white;
    font-size: 1.8rem;
    font-weight: bold;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

.menu-btn i {
    font-size: 3rem;
    color: #60a5fa;
}

.menu-btn.quiz i {
    color: #f59e0b;
}

.menu-btn:active, .menu-btn:hover {
    background: #3b82f6;
    border-color: #60a5fa;
    transform: scale(0.98);
}

/* KARTU MATERI */
.content-card {
    background: #1e293b;
    border: 3px solid #334155;
    border-radius: 25px;
    padding: 50px;
    width: 90%;
    max-width: 1100px;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.content-card h2 {
    font-size: 2.2rem;
    color: #60a5fa;
    border-bottom: 2px solid #334155;
    padding-bottom: 15px;
}

.content-body p {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 20px;
}

.highlight-box {
    background: #0f172a;
    border-left: 6px solid #3b82f6;
    padding: 25px;
    border-radius: 10px;
}

.highlight-box h3 {
    font-size: 1.4rem;
    color: #f8fafc;
    margin-bottom: 15px;
}

.highlight-box ul {
    margin-left: 25px;
}

.highlight-box li, .box li {
    font-size: 1.3rem;
    color: #cbd5e1;
    margin-bottom: 10px;
    line-height: 1.4;
}

/* DUAL COLUMN (MANFAAT & HAMBATAN) */
.dual-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.box {
    background: #0f172a;
    padding: 30px;
    border-radius: 15px;
    border: 2px solid #334155;
}

.box.benefit h3 { color: #22c55e; font-size: 1.5rem; margin-bottom: 15px; }
.box.barrier h3 { color: #ef4444; font-size: 1.5rem; margin-bottom: 15px; }
.box ul { margin-left: 20px; }

/* KEBIJAKAN GRID */
.policy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.policy-card {
    background: #0f172a;
    padding: 25px;
    border-radius: 15px;
    border: 2px solid #334155;
}

.policy-card strong {
    font-size: 1.3rem;
    color: #38bdf8;
    display: block;
    margin-bottom: 10px;
}

.policy-card p {
    font-size: 1.1rem !important;
    color: #cbd5e1;
}

/* TOMBOL KEMBALI */
.back-btn {
    align-self: flex-start;
    background: #475569;
    color: white;
    border: none;
    padding: 15px 30px;
    font-size: 1.2rem;
    border-radius: 12px;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background 0.2s;
}

.back-btn:active {
    background: #64748b;
}

/* KUIS STYLING */
.q-text {
    font-size: 1.6rem;
    font-weight: bold;
    color: #f8fafc;
    margin-bottom: 30px;
}

.options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.option-btn {
    background: #0f172a;
    border: 2px solid #475569;
    color: white;
    padding: 25px;
    font-size: 1.3rem;
    border-radius: 15px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
}

.option-btn:active, .option-btn:hover {
    border-color: #3b82f6;
    background: #1e3a8a;
}

.feedback {
    font-size: 1.3rem;
    font-weight: bold;
    min-height: 40px;
    margin-bottom: 20px;
}

/* FOOTER */
.ifp-footer {
    background: #1e293b;
    border-top: 3px solid #334155;
    padding: 15px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.footer-home {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 10px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-info {
    font-size: 1.1rem;
    color: #64748b;
}